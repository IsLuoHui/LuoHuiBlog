---
const friendLinks = [
	{
		name: "Link0327",
		url: "https://me0w.org",
		avatar: "https://me0w.org/img/artwork.jpg",
		desc: "喵🐱me0w, but furry wolf. 尝试变得毛茸茸",
	},
];

import MainGridLayout from "../layouts/MainGridLayout.astro";

import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
---
<MainGridLayout title={i18n(I18nKey.friendlink)} description={i18n(I18nKey.friendlink)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">

            <div class="flex flex-col gap-4 w-full">

                {friendLinks.map(link => (
                    <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class=" w-full
                                rounded-lg
                                bg-none
                                hover:bg-[var(--btn-plain-bg-hover)]
                                active:bg-[var(--btn-plain-bg-active)]
                                transition-all
                                pl-2
                                hover:pl-3
                                text-neutral-700
                                dark:text-neutral-300
                                hover:text-[var(--primary)]
                                dark:hover:text-[var(--primary)]
                                cursor-pointer
                                flex items-center gap-3
                                py-3
                                "
                    >
                        <img
                            src={link.avatar}
                            alt={link.name}
                            class="w-14 h-14 rounded-full object-cover"
                        />

                        <div class="flex flex-col">
                            <div class="text-lg font-semibold">{link.name}</div>
                            <div class="text-sm opacity-70">{link.desc}</div>
                        </div>
                    </a>
                ))}

            </div>

        </div>
    </div>
</MainGridLayout>
